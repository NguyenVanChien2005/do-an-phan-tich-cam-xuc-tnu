# ==============================================================================
# TNU Sentiment — Cấu hình môi trường mẫu (.env.example)
# Sao chép tệp này thành .env và điền thông số thực tế (KHÔNG commit .env lên Git)
# ==============================================================================

# Chế độ khởi động mặc định: "demo" hoặc "real"
# Lưu ý: Nếu chọn "real" nhưng MySQL lỗi kết nối, ứng dụng sẽ báo lỗi rõ ràng
# chứ KHÔNG tự động chuyển sang dữ liệu giả mà không thông báo.
APP_MODE=demo

# Múi giờ hiển thị và xử lý khoảng ngày
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ------------------------------------------------------------------------------
# Kết nối Cơ sở dữ liệu MySQL (Chế độ kết nối dữ liệu thật)
# Có thể khai báo DATABASE_URL trực tiếp hoặc từng biến thành phần bên dưới
# ------------------------------------------------------------------------------
DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tnu_sentiment_db
MYSQL_USER=tnu_app_user
MYSQL_PASSWORD=

# ------------------------------------------------------------------------------
# Cấu hình Checkpoint Mô hình
# ------------------------------------------------------------------------------
# Đường dẫn thư mục chứa checkpoint PhoBERT đã fine-tune hợp lệ
SENTIMENT_CHECKPOINT_DIR=phobert_tnu_best_model-20261101T002214Z-1-001/phobert_tnu_best_model
SENTIMENT_MODEL_VERSION=PhoBERT-base-v2-Focal-TNU-v1
SENTIMENT_MAX_LENGTH=256

# Đường dẫn checkpoint phân loại chủ đề (để trống nếu gán chủ đề thủ công)
TOPIC_CHECKPOINT_DIR=
TOPIC_MODEL_VERSION=

# Ngưỡng độ tự tin thử nghiệm để gắn cờ NEEDS_REVIEW (không phải ngưỡng tối ưu đã kiểm chứng)
CONFIDENCE_REVIEW_THRESHOLD=0.65

# Quy tắc cảnh báo tỷ lệ tiêu cực minh họa tại trang Tổng quan
NEGATIVE_ALERT_RATIO_THRESHOLD=0.35
NEGATIVE_ALERT_MIN_SAMPLES=30

# Giới hạn nhập liệu và Import CSV/XLSX
MAX_INPUT_CHARS=2000
IMPORT_MAX_FILE_MB=10
IMPORT_MAX_ROWS=5000

# Thư mục đọc kết quả thực nghiệm (Benchmark/Evaluation artifacts)
EVALUATION_ARTIFACTS_DIR=artifacts/evaluation

# Chuỗi muối nội bộ phục vụ băm ẩn danh một chiều (KHÔNG hiển thị trên giao diện)
SECRET_SALT=change-this-local-random-salt-before-production

# ------------------------------------------------------------------------------
# Tích hợp LLM hỗ trợ (TÙY CHỌN — Mặc định TẮT, không chặn ứng dụng chính)
# ------------------------------------------------------------------------------
LLM_ENABLED=false
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=
LLM_TIMEOUT_SECONDS=10

