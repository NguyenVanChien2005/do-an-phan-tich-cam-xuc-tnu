# ==============================================================================
# TNU Sentiment — Tệp cấu hình môi trường mẫu (.env.example)
# Sao chép thành tệp .env khi chạy thực tế (TUYỆT ĐỐI KHÔNG đẩy .env lên Git)
# ==============================================================================

# 1. Cấu hình Kết nối MySQL 8.0 (Nếu để trống ứng dụng tự chuyển sang CSV Fallback Mode)
DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tnu_sentiment_db
MYSQL_USER=root
MYSQL_PASSWORD=

# 2. Cấu hình Bảo mật & Ẩn danh PII (Nghị định 13/2023/NĐ-CP)
SECRET_SALT=TNU_ICTU_2026

# 3. Cấu hình Đường dẫn Mô hình PhoBERT đã tinh chỉnh
SENTIMENT_CHECKPOINT_DIR=phobert_tnu_best_model-20261101T002214Z-1-001/phobert_tnu_best_model
TOPIC_CHECKPOINT_DIR=

# 4. Cấu hình Định tuyến Lai Gemini API (khi PhoBERT confidence < 0.65)
# Nếu để trống, hệ thống tự động sử dụng Keyword Rule Fallback trong src/llm_fallback.py
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
